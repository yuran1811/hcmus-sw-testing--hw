            },
            "url": {
              "raw": "{{baseUrl}}/api/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checkout"
              ]
            },
            "description": "Data-driven execution; case metadata comes from the matching external JSON file."
          }
        }
