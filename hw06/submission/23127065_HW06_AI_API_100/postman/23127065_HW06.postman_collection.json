{
  "info": {
    "name": "23127065 HW06 API Testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pool A login, Pool B checkout, and Pool C admin order-state testing."
  },
  "event": [
    {
