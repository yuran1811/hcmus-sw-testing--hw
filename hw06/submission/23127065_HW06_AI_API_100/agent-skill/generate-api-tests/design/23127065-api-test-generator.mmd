%% Architecture Diagram for 23127065 AI-Driven API Test Generator Skill
flowchart TD
    %% Styling and Theme
    classDef inputNode fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1;
    classDef processNode fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px,color:#4A148C;
    classDef decisionNode fill:#FFF8E1,stroke:#FFA000,stroke-width:2px,color:#FF6F00;
    classDef humanNode fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#BF360C;
    classDef outputNode fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20;
    classDef storageNode fill:#ECEFF1,stroke:#455A64,stroke-width:2px,color:#263238;

    subgraph Inputs ["1. Input Specifications & Context"]
        A1["API Specification\n(Swagger / REST Contract)"]:::inputNode
        A2["Route Implementation\n(Backend Express Handlers)"]:::inputNode
        A3["Student Identity & Config\n(ID: 23127065 | Target: 40/API)"]:::inputNode
    end

    subgraph Parsing ["2. Contract Parsing & Differential Analysis"]
        B1["Parse Endpoint Contract\n(Params, Schema, Auth, State Machine)"]:::processNode
        B2{"Contract\nComplete?"}:::decisionNode
        B3["Stop & Request Contract Clarification"]:::humanNode
        B4["Route Inspection & Differential Analysis\n(Identify Spec vs Code Discrepancies)"]:::processNode
        B5[("Discrepancy Registry\n(Preserve Original Spec Expectations)")]:::storageNode
    end

    subgraph Generation ["3. Multi-Partition Test Case Generation (AI Engine)"]
        C1["Equivalence Partitioning & BVA\n(Valid, Boundary, Null, Type Mismatch)"]:::processNode
        C2["Auth & Access Control Matrix\n(Missing Token, Expired, Role Escalation)"]:::processNode
        C3["Security & Resilience Patterns\n(SQLi, XSS, Payload Limits, IDOR)"]:::processNode
        C4["State Transition Matrix\n(Valid, Illegal, Out-of-Sequence States)"]:::processNode
        C5["Candidate Aggregator & Deduplicator\n(Ensure >= 35 Unique AI Candidates)"]:::processNode
    end

    subgraph AuditGate ["4. Human-in-the-Loop Audit & Extension"]
        D1["AI Audit Classification\n(VALID / INVALID / INCOMPLETE)"]:::processNode
        D2["Human Review & Correction Gate\n(Fix Assumptions & Document Rationales)"]:::humanNode
        D3["Student Extension Layer\n(Author 5 High-Risk Extension Cases / API)"]:::humanNode
        D4["Final Test Matrix Validation\n(Exactly 40 Cases / API, 120 Total)"]:::processNode
    end

    subgraph ExportExecution ["5. Asset Generation & Test Execution"]
        E1["Export Engine\n(generate_submission.py)"]:::processNode
        E2[("Excel Review Workbook\n(23127065_HW06_Test_Cases.xlsx)")]:::storageNode
        E3[("External JSON Test Data\n(login, checkout, orderstatus)")]:::storageNode
        E4[("Postman Collection & Env\n(Pre-request: X-Student-Id 23127065)")]:::storageNode
        E5["Newman CLI Automation Runner\n(Isolated SUT Backend Execution)"]:::processNode
    end

    subgraph ReportingDefects ["6. Evidence Collection & Defect Reporting"]
        F1["Evidence Harvesting\n(CLI, JSON, JUnit XML, HTML Reports)"]:::outputNode
        F2["Assertion Analysis & Defect Triaging\n(Group Symptoms into Root Causes)"]:::processNode
        F3["GitHub Issue Filing & Bug Reports\n(6 Verified SUT Bugs with Reproduction)"]:::outputNode
        F4["Submission Documentation\n(Main Report, AI Audit, CI/CD, Critique)"]:::outputNode
    end

    %% Flow Connections
    A1 --> B1
    A3 --> B1
    B1 --> B2
    B2 -- "No" --> B3
    B2 -- "Yes" --> B4
    A2 --> B4
    B4 --> B5
    B4 --> C1 & C2 & C3 & C4

    C1 & C2 & C3 & C4 --> C5
    C5 --> D1
    D1 --> D2
    B5 -.-> D2
    D2 --> D3
    D3 --> D4

    D4 --> E1
    E1 --> E2 & E3 & E4
    E3 & E4 --> E5

    E5 --> F1
    F1 --> F2
    F2 --> F3
    F1 & F3 --> F4
